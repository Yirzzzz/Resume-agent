# Interview model provider configuration (server-side)
# Copy to `.env` and fill real values.

INTERVIEW_BASE_URL=https://api-inference.modelscope.cn/v1
INTERVIEW_API_KEY=your_api_key_here
INTERVIEW_MODEL=Qwen/Qwen3-32B

# Aliyun Model Studio / DashScope OpenAI-compatible example:
# INTERVIEW_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# INTERVIEW_API_KEY=your_dashscope_api_key_here
# Alternatively, set DASHSCOPE_API_KEY directly; INTERVIEW_API_KEY takes precedence.
# INTERVIEW_MODEL=deepseek-v4-pro
# Deep Interview uses JSON schema output; keep thinking disabled for prepare/start/answer.
# INTERVIEW_ENABLE_THINKING=false

# Interview research provider configuration
# Optional. Without TAVILY_API_KEY, interview-search and interview-agent use mock search fallback.
TAVILY_API_KEY=
JINA_READER_ENABLED=false

# Deep interview agent budgets
INTERVIEW_AGENT_MAX_SEARCH_ROUNDS=3
INTERVIEW_AGENT_MAX_PAGES=20
INTERVIEW_AGENT_PREPARE_LLM_LIMIT=15
INTERVIEW_AGENT_TURN_LLM_LIMIT=4
INTERVIEW_AGENT_SESSION_LLM_LIMIT=80
INTERVIEW_AGENT_MAX_FOLLOW_UP=2
INTERVIEW_AGENT_COVERAGE_THRESHOLD=0.8
INTERVIEW_AGENT_LLM_TIMEOUT_MS=120000
